# =============================================================================
# Advanced Search Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Django Core ----
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- AI Provider ----
# Options: 'openai' or 'groq'
PRIMARY_AI_PROVIDER=openai
AI_FALLBACK_TO_OPENAI=True

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Groq (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq-1

# ---- Vector DB ----
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-search-engine

# ---- Search ----
TAVILY_API_KEY=your_tavily_api_key_here

# Set true only for local demos without API keys (returns mock sources/answers).
ALLOW_MOCK_SEARCH=False

# ---- Rate Limiting ----
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXPORT_PER_MINUTE=5

# ---- Sentry Error Tracking ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend / FormForge ----
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@formforge.local
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google-callback

# Stripe payment keys are stored per-form in the Integrations UI (test keys recommended locally).
# Slack Incoming Webhook / Notion token / Zapier Catch Hook are also per-form configs.

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log