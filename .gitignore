# .gitignore for Django + Next.js AI Search Engine

# =====================================
# Python / Django
# =====================================

# Virtual Environment
venv/
env/
ENV/
.venv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles
/static

# Environment Variables
.env
*.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# =====================================
# Next.js / Frontend
# =====================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.local.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# =====================================
# API Keys & Secrets
# =====================================

# Never commit these!
*secret*
*SECRET*
*key*
*KEY*
credentials.json
secrets.json

# =====================================
# Docker
# =====================================

# ignore optional compose override file
docker-compose.override.yml

# =====================================
# OS Generated
# =====================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =====================================
# Misc
# =====================================

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
.cache/
